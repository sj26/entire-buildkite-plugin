#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
  echo 'Entire: automatic installation supports Linux x86_64 only; install Entire on PATH first.' >&2
  exit 1
fi

archive="$(mktemp)"
trap 'rm -f -- "$archive"' EXIT
curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
  --connect-timeout 15 --max-time 180 --retry 2 \
  'https://github.com/entireio/cli/releases/download/v0.11.4/entire_linux_amd64.tar.gz' \
  --output "$archive"
printf '%s  %s\n' b93634124bf51bc5e07156d92b53853d124325a3ff9af60c4960307bf8eb870f "$archive" \
  | sha256sum --check --status || { echo 'Entire: release checksum mismatch.' >&2; exit 1; }
mkdir -p "$HOME/.local/bin"
tar -xzf "$archive" -C "$HOME/.local/bin" entire git-remote-entire
